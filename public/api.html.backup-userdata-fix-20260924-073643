    <script>
        // ==========================================
        // UI INTERACTIONS
        // ==========================================

        function toggleDropdown(event) {
            event.stopPropagation();
            const container = document.querySelector('.profile-dropdown-container');
            if(container) container.classList.toggle('active');
        }

        document.addEventListener('click', function(e) {
            const container = document.querySelector('.profile-dropdown-container');
            if (container && container.classList.contains('active') && !container.contains(e.target)) {
                container.classList.remove('active');
            }
        });

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            if (window.matchMedia('(min-width: 1024px)').matches) return; 
            
            if (sidebar.classList.contains('sidebar-closed')) {
                sidebar.classList.remove('sidebar-closed');
                sidebar.classList.add('sidebar-open');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.remove('sidebar-open');
                sidebar.classList.add('sidebar-closed');
                overlay.classList.add('hidden');
            }
        }

        // ==========================================
        // TOAST SYSTEM
        // ==========================================

        let toastTimer = null;

        function showToast(type, title, message) {
            const toast = document.getElementById("toast");
            const icon = document.getElementById("toastIcon");
            const titleElement = document.getElementById("toastTitle");
            const messageElement = document.getElementById("toastMessage");

            if (!toast || !icon || !titleElement || !messageElement) return;

            clearTimeout(toastTimer);
            icon.className = `toast-icon ${type} mt-0.5 shrink-0`;

            if (type === "error") {
                icon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86l-7.82 13.5A2 2 0 004.2 20h15.6a2 2 0 001.73-2.64l-7.82-13.5a2 2 0 00-3.42 0z"></path></svg>`;
            } else if (type === "info") {
                icon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 21a9 9 0 100-18 9 9 0 000 18z"></path></svg>`;
            } else {
                icon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
            }

            titleElement.textContent = title || "Notice";
            messageElement.textContent = message || "";
            toast.classList.add("show");

            toastTimer = setTimeout(() => { hideToast(); }, 3500);
        }

        function hideToast() {
            const toast = document.getElementById("toast");
            if (toast) toast.classList.remove("show");
            clearTimeout(toastTimer);
        }

        function showComingSoon(event, name) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const container = document.querySelector(".profile-dropdown-container");
            if (container) container.classList.remove("active");
            showToast("info", "Coming Soon", `${name} will be available soon.`);
        }

        // ==========================================
        // API KEY LOGIC (UI Shell)
        // ==========================================

        function toggleVisibility() {
            const input = document.getElementById('apiKey');
            const icon = document.getElementById('eyeIcon');
            if (input.type === "password") {
                input.type = "text";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>`;
            } else {
                input.type = "password";
                icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>`;
            }
        }

        async function copyApiKey() {
            const input = document.getElementById('apiKey');
            const btn = document.getElementById('copyApiBtn');
            const text = document.getElementById('copyApiText');
            
            const isPassword = input.type === "password";
            if(isPassword) input.type = "text";
            
            try {
                await navigator.clipboard.writeText(input.value);
            } catch(e) {
                input.select();
                document.execCommand('copy');
            }
            
            if(isPassword) input.type = "password";

            btn.classList.add('bg-emerald-600', 'border-emerald-500', 'text-white');
            btn.classList.remove('bg-[#0a0e17]', 'border-gray-700', 'text-gray-300');
            text.innerText = "Copied!";
            showToast('success', 'Copied!', 'API Key copied to clipboard.');

            setTimeout(() => {
                btn.classList.remove('bg-emerald-600', 'border-emerald-500', 'text-white');
                btn.classList.add('bg-[#0a0e17]', 'border-gray-700', 'text-gray-300');
                text.innerText = "Copy";
            }, 2000);
        }

        async function regenerateKey() {
            if (!confirm(
                "Are you sure? Your existing API key will immediately stop working."
            )) {
                return;
            }

            try {
                const response = await fetch(
                    "/api/key/regenerate",
                    {
                        method: "POST",
                        credentials: "include"
                    }
                );

                let result = null;

                try {
                    result = await response.json();
                } catch (error) {
                    throw new Error("Invalid server response.");
                }

                if (!response.ok) {
                    throw new Error(
                        result?.message ||
                        "Unable to regenerate API key."
                    );
                }

                const newKey =
                    result?.api_key ||
                    result?.key ||
                    result?.data?.api_key ||
                    result?.data?.key;

                if (!newKey) {
                    throw new Error(
                        "New API key was not returned by the server."
                    );
                }

                const input =
                    document.getElementById("apiKey");

                if (input) {
                    input.value = newKey;
                    input.type = "password";
                }

                showToast(
                    "success",
                    "Key Regenerated",
                    "Your new API Key is ready to use."
                );

            } catch (error) {
                console.error(
                    "API key regeneration error:",
                    error
                );

                showToast(
                    "error",
                    "Regeneration Failed",
                    error?.message ||
                    "Unable to regenerate API key."
                );
            }
        }

        // ==========================================
        // LOAD REAL API KEY
        // ==========================================

        async function loadApiKey() {
            const input =
                document.getElementById("apiKey");

            if (!input) return;

            input.value = "Fetching...";

            try {
                const response = await fetch(
                    "/api/key",
                    {
                        method: "GET",
                        credentials: "include"
                    }
                );

                let result = null;

                try {
                    result = await response.json();
                } catch (error) {
                    throw new Error("Invalid server response.");
                }

                if (response.status === 401) {
                    window.location.href = "/";
                    return;
                }

                if (!response.ok) {
                    throw new Error(
                        result?.message ||
                        "Unable to load API key."
                    );
                }

                const key =
                    result?.api_key ||
                    result?.key ||
                    result?.data?.api_key ||
                    result?.data?.key;

                if (!key) {
                    throw new Error(
                        "API key was not returned by the server."
                    );
                }

                input.value = key;

            } catch (error) {
                console.error(
                    "API key loading error:",
                    error
                );

                input.value = "Unable to load API key";

                showToast(
                    "error",
                    "API Key Error",
                    error?.message ||
                    "Unable to load your API key."
                );
            }
        }

        // ==========================================
        // CODE TABS LOGIC
        // ==========================================

        function showCode(lang) {
            const tabs = ['curl', 'python', 'php', 'json'];
            tabs.forEach(t => {
                document.getElementById(`tab-${t}`).className = "text-gray-400 hover:text-gray-300 font-medium pb-1 whitespace-nowrap transition";
                document.getElementById(`code-${t}`).classList.add('hidden');
                document.getElementById(`code-${t}`).classList.remove('block');
            });
            
            document.getElementById(`tab-${lang}`).className = "text-cyan-400 font-semibold border-b-2 border-cyan-400 pb-1 whitespace-nowrap transition";
            document.getElementById(`code-${lang}`).classList.remove('hidden');
            document.getElementById(`code-${lang}`).classList.add('block');
        }

        // ==========================================
        // STUB LOAD USER & LOGOUT
        // ==========================================

        async function loadUser() {
            try {
                const response = await fetch("/api/me", {
                    method: "GET",
                    credentials: "include"
                });

                if (!response.ok) {
                    window.location.href = "/";
                    return;
                }

                const result = await response.json();

                if (
                    result.status !== "success" ||
                    !result.user
                ) {
                    window.location.href = "/";
                    return;
                }

                const user = result.user;

                const name =
                    user.name ||
                    user.email ||
                    "Publisher";

                const email =
                    user.email ||
                    "—";

                const profileName =
                    document.getElementById("profileName");

                if (profileName) {
                    profileName.textContent = name;
                }

                const profileMenuName =
                    document.getElementById("profileMenuName");

                if (profileMenuName) {
                    profileMenuName.textContent = name;
                }

                const profileMenuEmail =
                    document.getElementById("profileMenuEmail");

                if (profileMenuEmail) {
                    profileMenuEmail.textContent = email;
                }

                const profileAvatar =
                    document.getElementById("profileAvatar");

                if (profileAvatar) {
                    const parts =
                        String(name)
                            .trim()
                            .split(/\s+/)
                            .filter(Boolean);

                    let initials = "U";

                    if (parts.length >= 2) {
                        initials =
                            (
                                parts[0][0] +
                                parts[parts.length - 1][0]
                            ).toUpperCase();
                    } else if (parts.length === 1) {
                        initials =
                            parts[0]
                                .substring(0, 2)
                                .toUpperCase();
                    }

                    profileAvatar.textContent = initials;
                }

            } catch (error) {
                console.error(
                    "Failed to load user:",
                    error
                );

                window.location.href = "/";
            }
        }

        async function logout(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            try {
                await fetch("/api/logout", {
                    method: "POST",
                    credentials: "include"
                });
            } catch (error) {
                console.error("Logout error:", error);
            }

            window.location.href = "/";
        }

        document.addEventListener("DOMContentLoaded", () => {
            loadUser();
            loadApiKey();
        });

    </script>
